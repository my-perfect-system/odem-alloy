{% set u = monitoring_grafana_url | urlsplit %}
prometheus.scrape "monitoring_grafana" {
  targets = [
    {
      "__address__" = "{{ u.hostname }}:{{ u.port | default(443 if u.scheme == 'https' else 80, true) }}",
      "__scheme__"  = "{{ u.scheme }}",
      "job"          = "monitoring-grafana",
    },
  ]
  forward_to      = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "{{ monitoring_grafana_scrape_interval }}"
  metrics_path    = "{{ u.path | default('/metrics', true) }}"
}
