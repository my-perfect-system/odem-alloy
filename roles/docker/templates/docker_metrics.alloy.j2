prometheus.exporter.cadvisor "all" {
  docker_host      = "unix:///var/run/docker.sock"
  storage_duration = "{{ docker_cadvisor_storage_duration }}"
  enabled_metrics  = {{ docker_cadvisor_enabled_metrics | tojson }}
}
prometheus.scrape "cadvisor" {
  targets         = prometheus.exporter.cadvisor.all.targets
  forward_to      = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "{{ docker_cadvisor_scrape_interval }}"
}
