services:
  cadvisor:
    image: "{{ docker_cadvisor_image }}"
    container_name: cadvisor
    pid: host
    privileged: true
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    devices:
      - /dev/kmsg
    ports:
      - "127.0.0.1:{{ docker_cadvisor_port }}:8080"
    restart: unless-stopped
