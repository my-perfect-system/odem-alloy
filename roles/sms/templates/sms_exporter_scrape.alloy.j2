prometheus.scrape "sms_exporter" {
  targets = [
    {"__address__" = "{{ sms_bind }}:{{ sms_port }}",
     "__scheme__"  = "https",
     "job"         = "sms"},
  ]
  forward_to      = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "{{ sms_scrape_interval }}"
  metrics_path    = "/metrics"
}
